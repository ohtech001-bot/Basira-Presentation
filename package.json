{
  "name": "basira-presentation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/build-offline.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --tsconfig tsconfig.app.json --test tests/*.test.ts tests/*.test.tsx",
    "test:scenes": "node scripts/validate-scenes.mjs",
    "test:offline": "node scripts/build-offline.mjs --verify"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0",
    "page-flip": "^2.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
